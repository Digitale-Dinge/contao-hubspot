{
    "name": "digitaledinge/contao-hubspot",
    "description": "Send Contao form submissions to the HubSpot Forms API, including legal consent.",
    "keywords": [
        "contao",
        "hubspot",
        "forms",
        "consent"
    ],
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Digitale Dinge GmbH",
            "homepage": "https://digitaledin.ge",
            "role": "Developer"
        },
        {
            "name": "Sebastian Zoglowek",
            "homepage": "https://github.com/zoglo",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/digitale-dinge/contao-hubspot/issues",
        "source": "https://github.com/digitale-dinge/contao-hubspot",
        "forum": "https://community.contao.org"
    },
    "require": {
        "php": "^8.4",
        "contao/core-bundle": "^5.7 || ^6.0",
        "doctrine/dbal": "^3.7 || ^4.3",
        "psr/log": "^3.0",
        "symfony/config": "^7.4 || ^8.1",
        "symfony/dependency-injection": "^7.4 || ^8.1",
        "symfony/http-client-contracts": "^3.0",
        "symfony/http-foundation": "^7.4 || ^8.1",
        "symfony/http-kernel": "^7.4 || ^8.1",
        "symfony/routing": "^7.4 || ^8.1",
        "symfony/translation": "^7.4 || ^8.1"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^13.3",
        "symfony/http-client": "^7.4 || ^8.1",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/security-core": "^7.4 || ^8.1",
        "symfony/yaml": "^7.4 || ^8.1"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "DigitaleDinge\\HubSpotBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DigitaleDinge\\HubSpotBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "ci": [
            "@rector",
            "@ecs",
            "@phpstan",
            "@depcheck",
            "@unit-tests"
        ],
        "depcheck": "@php vendor/bin/composer-dependency-analyser --config=depcheck.php",
        "ecs": "@php vendor-bin/ecs/vendor/bin/ecs check --fix",
        "ecs-check": "@php vendor-bin/ecs/vendor/bin/ecs check",
        "phpstan": "@php vendor-bin/phpstan/vendor/bin/phpstan analyse",
        "rector": "@php vendor-bin/rector/vendor/bin/rector process",
        "rector-check": "@php vendor-bin/rector/vendor/bin/rector process --dry-run",
        "unit-tests": "@php vendor/bin/phpunit --fail-on-phpunit-notice"
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": false
        },
        "contao-manager-plugin": "DigitaleDinge\\HubSpotBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false
        }
    }
}
